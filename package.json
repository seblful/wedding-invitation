{
  "name": "wedding-invitation",
  "version": "1.0.0",
  "description": "Wedding invitation website",
  "main": "server.js",
  "scripts": {
    "start": "npx tailwindcss -i ./public/input.css -o ./public/styles.css --minify && cross-env NODE_ENV=production node server.js",
    "dev": "npx tailwindcss -i ./public/input.css -o ./public/styles.css --watch & nodemon server.js",
    "build:css": "npx tailwindcss -i ./public/input.css -o ./public/styles.css",
    "build:css:prod": "npx tailwindcss -i ./public/input.css -o ./public/styles.css --minify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19"
  }
}
