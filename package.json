{
  "name": "wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "description": "Belarusian wedding invitation website — Express for development, static build on Cloudflare for production",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "run-p dev:css dev:server",
    "dev:css": "tailwindcss -i ./public/input.css -o ./public/styles.css --watch",
    "dev:server": "nodemon --watch src --watch config.js src/server.js",
    "prestart": "npm run build:css",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "build": "run-s build:css build:static",
    "build:css": "tailwindcss -i ./public/input.css -o ./public/styles.css --minify",
    "build:static": "node scripts/build-static.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "run-s lint format:check test build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run check && wrangler deploy"
  },
  "keywords": [
    "wedding",
    "invitation",
    "express",
    "tailwindcss",
    "cloudflare"
  ],
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.8",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.73.0"
  }
}
