# Copy to `.env` and load it with `node --env-file=.env src/server.js`.
# Every value here is optional; `config.js` supplies the defaults.

# Port the Express server listens on (default 3000).
PORT=3000

# Interface to bind (default 0.0.0.0; use 127.0.0.1 to stay local-only).
HOST=0.0.0.0

# `production` caches the rendered HTML; `development` re-renders per request.
NODE_ENV=development

# Overrides config.js `baseUrl`. Useful for testing Open Graph previews through
# a tunnel: npx --yes cloudflared tunnel --url http://localhost:3000
# BASE_URL=https://your-tunnel.trycloudflare.com

# Overrides config.js `form.formspreeEndpoint`, so test RSVPs do not land in
# the real inbox.
# FORMSPREE_ENDPOINT=https://formspree.io/f/your-test-form
